{
  "name": " ",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "keywords": [
    ""
  ],
  "license": "",
  "author": "",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:dom": "vitest run tests/unit/settings tests/unit/results",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests *.config.mjs",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"tests/**/*.{js,mjs}\" \".github/**/*.yml\" \"*.md\" \"*.config.mjs\"",
    "verify": "npm run format:check && npm run lint && npm run test:coverage && npm run build",
    "start": "webpack serve --open --config webpack.config.dev.js",
    "build": "webpack --config webpack.config.prod.js && jsdoc -c jsdoc.json",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@vitest/coverage-v8": "^4.1.11",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^10.9.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.1.7",
    "jsdoc": "^4.0.4",
    "jsdom": "^30.0.1",
    "mini-css-extract-plugin": "^2.9.2",
    "prettier": "^3.5.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "vitest": "^4.1.11",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "bootswatch": "^5.3.3"
  }
}
